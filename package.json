{
  "name": "youtube-mcp-tools",
  "version": "2.0.0",
  "mcpName": "io.github.fabioc-aloha/youtube-mcp-tools",
  "description": "Evidence-first YouTube research and collateral tools for MCP hosts and VS Code.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "youtube-mcp-tools": "./dist/mcp-server/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabioc-aloha/youtube-mcp-tools.git"
  },
  "bugs": {
    "url": "https://github.com/fabioc-aloha/youtube-mcp-tools/issues"
  },
  "homepage": "https://github.com/fabioc-aloha/youtube-mcp-tools#readme",
  "scripts": {
    "build": "tsc --project tsconfig.json && node scripts/add-mcp-shebang.mjs",
    "check-types": "tsc --noEmit --project tsconfig.json",
    "test": "npm run build && node --test dist/test/workflow.test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
