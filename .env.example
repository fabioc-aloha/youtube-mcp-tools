# Copy this file to .env and set values locally. Never commit .env.
# Create a Google Cloud project, enable YouTube Data API v3, then create a key:
# https://console.cloud.google.com/apis/credentials
# Restrict the key to YouTube Data API v3; use an IP restriction when the
# server has a stable egress address. Do not use browser-referrer restrictions
# for this local stdio server.
YOUTUBE_API_KEY=

# Optional direct collateral generation. Host-managed generation works without these.
# YOUTUBE_MCP_DIRECT_PROVIDER=openai-compatible
# YOUTUBE_MCP_DIRECT_API_KEY=
# YOUTUBE_MCP_DIRECT_MODEL=
# YOUTUBE_MCP_DIRECT_BASE_URL=
